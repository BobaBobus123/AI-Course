# Copy this file to .env. The default mock works without an API key or model.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL_NAME=gemini-3.8-flash
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2500
LLM_TIMEOUT_SECONDS=45

# Local Ollama mode. Install Ollama and pull this model once:
# ollama pull qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_NAME=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180

# Default mode shown in the web interface: mock, api, or ollama.
DEFAULT_LLM_MODE=mock

# true: use deterministic local mock, no API requests or API quota.
MOCK_LLM=false

# Maximum model -> tool -> model rounds for one question (1-20).
TOOL_MAX_ROUNDS=5

# Leave empty for a random development-only key; configure a random secret
# for stable sessions across restarts and multiple workers.
SESSION_SECRET=
SESSION_HTTPS_ONLY=false

# Shop-service fault injection for testing.
SHOP_DELAY_MS=0
SHOP_FAILURE_RATE=0
SHOP_TIMEOUT_SECONDS=10
SHOP_TODAY=2026-10-06
